{
  "keyboard_name": "mymacropad",
  "manufacturer": "Yu Chen Liu",
  "maintainer": "IMMAHUMAN",
  "url": "https://github.com/insertnewusername",
  "processor": "RP2040",
  "bootloader": "rp2040",
  "features": {
    "bootmagic": true,
    "encoder": true,
    "extrakey": true,
    "mousekey": true,
    "nkro": true
  },
  "diode_direction": "COL2ROW",
  "matrix_pins": {
    "cols": ["GP2", "GP3", "GP4"],
    "rows": ["GP0", "GP1"]
  },
  "usb": {
    "vid": "0xFEED",
    "pid": "0x0000",
    "device_version": "0.0.1"
  },
  "encoder": {
    "rotary": [
      {
        "pin_a": "GP6",
        "pin_b": "GP7",
        "resolution": 4
      }
    ]
  },
  "layouts": {
    "LAYOUT": {
      "layout": [
        { "matrix": [0, 0], "x": 0, "y": 0 },
        { "matrix": [0, 1], "x": 1, "y": 0 },
        { "matrix": [0, 2], "x": 2, "y": 0 },
        { "matrix": [1, 0], "x": 0, "y": 1 },
        { "matrix": [1, 1], "x": 1, "y": 1 },
        { "matrix": [1, 2], "x": 2, "y": 1 }
      ]
    }
  }
}
